# Copy to ".env" and fill in, or set these as real environment variables.
# (In PowerShell:  $env:SCRAPER_API_KEY="..."   or persist with  setx )

# ---- Carrefour (beats Akamai via a web-unblocking service) ----
# Get a free-trial key from https://www.zenrows.com or https://www.scraperapi.com
SCRAPER_PROVIDER=zenrows          # zenrows | scraperapi
SCRAPER_API_KEY=

# ---- Aoun / Le Charcutier (prices are login-gated) ----
# A real account on https://www.lecharcutier.com
AOUN_USERNAME=
AOUN_PASSWORD=

# ---- General ----
PRICEMON_INTERVAL_MIN=30
